# =====================================================================
# Server
# =====================================================================
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173

# =====================================================================
# Database (PostgreSQL)
# =====================================================================
# Option A (default on this machine): the local portable Postgres installed at
#   C:\Users\ALGO\pgportable  (port 5433). Started automatically by `npm run dev`.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/phonedash?schema=public"
#
# Option B: a hosted Postgres (Neon, Supabase, etc.) — just paste its URL above,
#   e.g. postgresql://user:pass@host/db?sslmode=require

# =====================================================================
# Auth
# =====================================================================
# Long random string used to sign JWTs (min 16 chars).
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRES_IN=7d
# AUTH_COOKIE_NAME=pd_token

# =====================================================================
# First admin (created by `npm run db:seed`)
# =====================================================================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# =====================================================================
# CPaaS provider
# =====================================================================
# Leave PROVIDER unset to auto-select: Twilio if the creds below are present,
# otherwise the built-in "mock" provider (no account needed, nothing costs money).
# Force one explicitly with: PROVIDER=mock  or  PROVIDER=twilio
# PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
#
# Public HTTPS base URL Twilio should POST inbound SMS to. Required for REAL
# inbound with Twilio (use an ngrok/cloudflared tunnel in dev). The webhook path
# is <PUBLIC_BASE_URL>/webhooks/twilio/sms
# PUBLIC_BASE_URL=https://your-tunnel.ngrok-free.app

# =====================================================================
# Credits
# =====================================================================
# Cost in credits to send one SMS.
SMS_COST_CREDITS=1
